LESS_CODEX_MODEL=
LESS_CODEX_TIMEOUT=180
LESS_MAX_ITEMS_PER_CHECK=5
LESS_AUTO_NORMALIZE=false
LESS_AI_DAILY_LIMIT=10
LESS_TIMEZONE=Asia/Shanghai
