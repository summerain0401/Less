# Default: sqlite:////absolute/path/to/repository/data/less.db
# LESS_DATABASE_URL=sqlite:////absolute/path/to/less.db
LESS_TIMEZONE=Asia/Shanghai

# Required for automatic digest emails. Use an app password, never your mailbox login password.
# LESS_SMTP_HOST=smtp.example.com
# LESS_SMTP_PORT=587
# LESS_SMTP_USERNAME=sender@example.com
# LESS_SMTP_PASSWORD=app-password
# LESS_MAIL_FROM=sender@example.com
# LESS_MAIL_TO=reader@example.com
